# ==============================================================================
# HyperKart Commerce Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.

# --- MongoDB Connection (Primary Database) ---
MONGODB_URI=mongodb://localhost:27017/hyperkartdb
# Docker Compose MongoDB root credentials (used for authenticated containers)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# --- JSON Web Token Security Parameters ---
# IMPORTANT: Change this secret in production (minimum 256-bit / 32 characters)
JWT_SECRET=hyperkart-commerce-jwt-secret-key-change-in-production-min-256-bits
# Token expiry: 24 hours (in milliseconds)
JWT_EXPIRATION_MS=86400000

# --- App Admin Credentials (Single Designated System Administrator) ---
ADMIN_EMAIL=admin@hyperkart.com
ADMIN_PASSWORD=AdminPassword123!

# --- Server Configuration ---
SERVER_PORT=8085

# --- Cross-Origin Resource Sharing (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI / OpenAI Configuration (Optional - falls back to rule-based scoring) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AI Microservice URL (FastAPI Python service) ---
AI_SERVICE_URL=http://localhost:8001

# --- Google Maps API Key (Optional - for backend geocoding) ---
GOOGLE_MAPS_API_KEY=

# --- Social Auth SSO Configuration (Optional - for Google & Facebook OAuth) ---
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

